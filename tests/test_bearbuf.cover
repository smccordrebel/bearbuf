   22:     ui.log_err = Mock()
   22:     return ui
       
       
    2: class TestInputValidation(unittest.TestCase):
    1:     def setUp(self):
    6:         self.ui = make_ui()
       
    1:     def test_validate_integer_entry_accepts_blank_and_digits(self):
    1:         self.assertTrue(self.ui.validate_integer_entry(""))
    1:         self.assertTrue(self.ui.validate_integer_entry("0"))
    1:         self.assertTrue(self.ui.validate_integer_entry("123"))
       
    1:     def test_validate_integer_entry_rejects_invalid_values(self):
    1:         self.assertFalse(self.ui.validate_integer_entry("-1"))
    1:         self.assertFalse(self.ui.validate_integer_entry("12.3"))
    1:         self.assertFalse(self.ui.validate_integer_entry("abc"))
       
    1:     def test_validate_float_entry_accepts_valid_values(self):
    1:         self.assertTrue(self.ui.validate_float_entry(""))
    1:         self.assertTrue(self.ui.validate_float_entry("."))
    1:         self.assertTrue(self.ui.validate_float_entry("0"))
    1:         self.assertTrue(self.ui.validate_float_entry("123.45"))
       
    1:     def test_validate_float_entry_rejects_invalid_values(self):
    1:         self.assertFalse(self.ui.validate_float_entry("-0.1"))
    1:         self.assertFalse(self.ui.validate_float_entry("1.2.3"))
    1:         self.assertFalse(self.ui.validate_float_entry("abc"))
       
    1:     def test_parse_positive_number_accepts_positive_and_zero_when_allowed(self):
    2:         self.assertEqual(
    1:             self.ui.parse_positive_number("12.5", "Field"),
    1:             12.5
               )
    2:         self.assertEqual(
    1:             self.ui.parse_positive_number("0", "Field", allow_zero=True),
    1:             0
               )
       
    1:     def test_parse_positive_number_rejects_missing_invalid_and_negative_values(self):
    2:         with self.assertRaisesRegex(ValueError, "Field is required."):
    1:             self.ui.parse_positive_number("  ", "Field")
       
    2:         with self.assertRaisesRegex(ValueError, "Field must be a valid number."):
    1:             self.ui.parse_positive_number("abc", "Field")
       
    2:         with self.assertRaisesRegex(ValueError, "Field must be greater than 0."):
    1:             self.ui.parse_positive_number("0", "Field")
       
    2:         with self.assertRaisesRegex(ValueError, "Field must be 0 or greater."):
    1:             self.ui.parse_positive_number("-1", "Field", allow_zero=True)
       
       
    2: class TestRateCalculations(unittest.TestCase):
    1:     def setUp(self):
    1:         self.ui = make_ui()
       
    1:     def test_weekly_rate_from_annual_handles_core_rates(self):
    1:         self.assertEqual(self.ui.weekly_rate_from_annual(0), 0)
    2:         self.assertAlmostEqual(
    1:             self.ui.weekly_rate_from_annual(100),
    1:             (2 ** (1 / 52)) - 1
               )
    2:         self.assertAlmostEqual(
    1:             self.ui.weekly_rate_from_annual(500),
    1:             (6 ** (1 / 52)) - 1
               )
       
       
    2: class TestBearMarketDetection(unittest.TestCase):
    1:     def setUp(self):
    5:         self.ui = make_ui()
       
    1:     def test_bear_start_analyze_detects_twenty_percent_drop(self):
    1:         prices = [10] * 10 + [8]
    1:         bears = [False] * len(prices)
       
    1:         bear_num = self.ui.bear_start_analyze(prices, bears)
       
    1:         self.assertEqual(bear_num, 1)
    1:         self.assertEqual(bears, [False] * 10 + [True])
       
    1:     def test_bear_start_analyze_returns_zero_for_stable_prices(self):
    1:         prices = [10, 10.1, 10.2, 10.3, 10.4, 10.5, 10.6, 10.7, 10.8, 10.9, 11]
    1:         bears = [True] * len(prices)
       
    1:         bear_num = self.ui.bear_start_analyze(prices, bears)
       
    1:         self.assertEqual(bear_num, 0)
    1:         self.assertEqual(bears, [False] * len(prices))
       
    1:     def test_bear_start_analyze_detects_multiple_bear_markets(self):
    1:         prices = [10] * 10 + [8] + [12] * 9 + [9.5, 9.5]
    1:         bears = [False] * len(prices)
       
    1:         bear_num = self.ui.bear_start_analyze(prices, bears)
       
    1:         self.assertEqual(bear_num, 2)
    1:         self.assertTrue(bears[10])
    1:         self.assertTrue(bears[20])
       
    1:     def test_bear_start_analyze_errors_for_non_positive_prices(self):
    1:         prices = [10] * 9 + [0, 8]
    1:         bears = [False] * len(prices)
       
    1:         bear_num = self.ui.bear_start_analyze(prices, bears)
       
    1:         self.assertIsNone(bear_num)
    1:         self.ui.log_err.assert_called_once_with("Stock price <= 0!")
    1:         self.assertEqual(bears, [False] * len(prices))
       
    1:     def test_bear_start_analyze_handles_small_datasets(self):
    1:         prices = [10, 9.5, 9]
    1:         bears = [True] * len(prices)
       
    1:         bear_num = self.ui.bear_start_analyze(prices, bears)
       
    1:         self.assertEqual(bear_num, 0)
    1:         self.assertEqual(bears, [False] * len(prices))
       
       
    2: class TestWeeklyExpenseCalculation(unittest.TestCase):
    1:     def test_weekly_expense_stock_calc_without_bear_market(self):
    1:         ui = make_ui()
    1:         weekly = bearbuf.WeeklyExpenses(100, 20, False, 500)
       
    1:         self.assertEqual(ui.weekly_expense_stock_calc(weekly), 5)
    1:         self.assertEqual(weekly.bear_calm_fund, 500)
       
    1:     def test_weekly_expense_stock_calc_uses_calm_fund_when_sufficient(self):
    1:         ui = make_ui()
    1:         weekly = bearbuf.WeeklyExpenses(100, 20, True, 150)
       
    1:         self.assertEqual(ui.weekly_expense_stock_calc(weekly), 0)
    1:         self.assertEqual(weekly.bear_calm_fund, 50)
       
    1:     def test_weekly_expense_stock_calc_uses_partial_calm_fund(self):
    1:         ui = make_ui()
    1:         weekly = bearbuf.WeeklyExpenses(100, 20, True, 40)
       
    1:         self.assertEqual(ui.weekly_expense_stock_calc(weekly), 3)
    1:         self.assertEqual(weekly.bear_calm_fund, 0)
       
    1:     def test_weekly_expense_stock_calc_sells_stock_when_calm_fund_depleted(self):
    1:         ui = make_ui()
    1:         weekly = bearbuf.WeeklyExpenses(100, 20, True, 0)
       
    1:         self.assertEqual(ui.weekly_expense_stock_calc(weekly), 5)
    1:         self.assertEqual(weekly.bear_calm_fund, 0)
       
       
    2: class TestStockListProcessing(unittest.TestCase):
    1:     def setUp(self):
    3:         self.ui = make_ui()
       
    1:     def test_stock_lists_get_returns_week_and_value_lists_for_valid_data(self):
    1:         self.ui.stock_date = ["2024-01-01", "2024-01-08"]
    1:         self.ui.stock_value = ["100", "101.5"]
       
    1:         weeks, values = self.ui.stock_lists_get()
       
    1:         self.assertEqual(weeks, [0, 1])
    1:         self.assertEqual(values, [100.0, 101.5])
    1:         self.ui.log_err.assert_not_called()
       
    1:     def test_stock_lists_get_errors_for_non_positive_prices(self):
    1:         self.ui.stock_date = ["2024-01-01", "2024-01-08"]
    1:         self.ui.stock_value = ["100", "0"]
       
    1:         weeks, values = self.ui.stock_lists_get()
       
    1:         self.assertEqual((weeks, values), ([], []))
    2:         self.ui.log_err.assert_called_once_with(
    1:             "Historical stock values must be greater than 0."
               )
       
    1:     def test_stock_lists_get_errors_for_mismatched_lengths(self):
    1:         self.ui.stock_date = ["2024-01-01", "2024-01-08"]
    1:         self.ui.stock_value = ["100"]
       
    1:         weeks, values = self.ui.stock_lists_get()
       
    1:         self.assertEqual((weeks, values), ([], []))
    2:         self.ui.log_err.assert_called_once_with(
    1:             "Stock date and stock value lists are not the same length"
               )
       
       
