    1: def install_gui_stubs():
    1:     tkinter = types.ModuleType("tkinter")
    1:     tkinter.Tk = type("Tk", (), {})
    1:     tkinter.Canvas = type("Canvas", (), {})
    1:     tkinter.VERTICAL = "vertical"
       
    1:     ttk = types.ModuleType("tkinter.ttk")
    7:     for name in ("Notebook", "Frame", "Scrollbar", "Label", "Entry", "Button"):
    6:         setattr(ttk, name, type(name, (), {}))
       
    1:     messagebox = types.ModuleType("tkinter.messagebox")
    1:     messagebox.showerror = Mock()
       
    1:     tkinter.ttk = ttk
    1:     tkinter.messagebox = messagebox
       
    1:     backend_tkagg = types.ModuleType("matplotlib.backends.backend_tkagg")
    1:     backend_tkagg.FigureCanvasTkAgg = type("FigureCanvasTkAgg", (), {})
       
    1:     figure_module = types.ModuleType("matplotlib.figure")
    1:     figure_module.Figure = type("Figure", (), {})
       
    1:     sys.modules["tkinter"] = tkinter
    1:     sys.modules["tkinter.ttk"] = ttk
    1:     sys.modules["tkinter.messagebox"] = messagebox
    1:     sys.modules["matplotlib.backends.backend_tkagg"] = backend_tkagg
    1:     sys.modules["matplotlib.figure"] = figure_module
       
       
    1: install_gui_stubs()
    1: if "bearbuf" in sys.modules:
           del sys.modules["bearbuf"]
    1: bearbuf = importlib.import_module("bearbuf")
       
       
    1: def make_ui():
   22:     ui = object.__new__(bearbuf.BearBufUI)
   22:     ui.stock_date = []
   22:     ui.stock_value = []
